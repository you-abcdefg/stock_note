<%= form_with(model: @post, local: true) do |form| %>
  <div class="form-group">
    <%= form.label :title, 'タイトル' %>
    <%= form.text_field :title, class: 'form-control', style: 'height: 48px; min-height: 48px; max-height: 48px; border: 2px solid #007bff; border-radius: 10px; background: #f4f8ff; box-shadow: 0 0 8px #b3d1ff; padding: 12px;' %>
  </div>
  <div class="form-group">
    <%= form.label :body, '本文' %>
    <!-- 本文エディタ内のカード間ボタン方式に一本化 -->
    <div id="body-editor" contenteditable="true" class="mb-2" style="height: 400px; min-height: 400px; max-height: 400px; overflow-y: auto; border: 2px solid #007bff; border-radius: 10px; background: #f4f8ff; box-shadow: 0 0 8px #b3d1ff; padding: 12px;"></div>
    <%= form.hidden_field :body, id: 'body-hidden' %>
    <%= render 'card_modal' %>
  </div>
  <!-- タグ選択UI（mainブランチ準拠） -->
  <div class="form-group mb-3">
    <label>タグ</label>
    <div class="d-flex align-items-center">
      <button type="button" class="btn btn-outline-primary" data-toggle="modal" data-target="#tagSelectModal">タグを選択</button>
      <button type="button" class="btn btn-outline-secondary ml-2" id="add-tag-button">タグを作成</button>
      <span id="selected-tags" class="ml-3 text-muted"></span>
    </div>
  </div>
  <!-- タグ選択モーダルは部分テンプレートで描画 -->
  <%= render 'tag_modal', form: form %>
  <div class="form-group d-flex justify-content-start mt-4" style="gap: 16px;">
    <%= form.submit '投稿', class: 'btn btn-primary px-4' %>
    <%= link_to 'キャンセル', posts_path, class: 'btn btn-secondary px-4' %>
  </div>
<% end %>
